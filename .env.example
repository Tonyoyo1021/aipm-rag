# 硅基流动 OpenAI 兼容接口；不要把真实密钥提交到 Git。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_EMBEDDING_MODEL=BAAI/bge-m3
OPENAI_CHAT_MODEL=XingChenAGI/Xing4.0-29B

RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_MIN_SCORE=0.45
RAG_REQUEST_TIMEOUT=120

# 可选：多个路径用英文逗号分隔；相对路径以 aipm_rag 目录为基准。
# RAG_DOCUMENT_PATHS=../../AI产品经理能力全景指南.md,../../秋招 AI 面试八股准备手册.md
